<script>
(function () {
    'use strict';
    var launcher = document.getElementById('mago-launcher-locked');
    var panel = document.getElementById('mago-locked');
    var close = document.getElementById('mago-locked-close');
    if (!launcher || !panel) {
        return;
    }
    function setOpen(open) {
        panel.hidden = !open;
        launcher.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    launcher.addEventListener('click', function () {
        setOpen(panel.hidden);
    });
    if (close) {
        close.addEventListener('click', function () {
            setOpen(false);
        });
    }
})();
</script>
