<?php
/** @var \MagoAssistant\Mago\Block\Adminhtml\ChatPanel $block */
/** @var \Magento\Framework\Escaper $escaper */
if (!$block->isVisible()) {
    return;
}
$accentColorRaw = $block->getAccentColor();
$textColorRaw = $block->getTextColor();
// Sanitize: only allow valid hex colors
$accentColor = preg_match('/^#[0-9a-fA-F]{6}$/', $accentColorRaw) ? $accentColorRaw : '#FF7A33';
$accentText = preg_match('/^#[0-9a-fA-F]{6}$/', $textColorRaw) ? $textColorRaw : '#FFFFFF';
// Compute derived colors from accent
$hex = ltrim($accentColor, '#');
$r = hexdec(substr($hex, 0, 2));
$g = hexdec(substr($hex, 2, 2));
$b = hexdec(substr($hex, 4, 2));
// Tint: the accent at ~15% over white. Carries the user's own messages and the
// "working" pill, so the panel stays light whatever accent is configured.
$accentColorLight = sprintf('#%02x%02x%02x', (int)(255 - (255 - $r) * 0.15), (int)(255 - (255 - $g) * 0.15), (int)(255 - (255 - $b) * 0.15));
$accentRgb = "$r,$g,$b";
// Hover: lighten dark colors, darken light colors
$luminance = 0.2126 * ($r / 255) + 0.7152 * ($g / 255) + 0.0722 * ($b / 255);
if ($luminance < 0.3) {
    $accentColorHover = sprintf('#%02x%02x%02x', min(255, (int)($r + (255 - $r) * 0.25)), min(255, (int)($g + (255 - $g) * 0.25)), min(255, (int)($b + (255 - $b) * 0.25)));
} else {
    $accentColorHover = sprintf('#%02x%02x%02x', (int)($r * 0.8), (int)($g * 0.8), (int)($b * 0.8));
}
$assistantName = $block->getAssistantName();
$adminName = $block->getAdminFirstName();
$hasAccess = $block->canUseAssistant();
// The welcome screen offers the first few skills as one-click starters.
$skills = json_decode($block->getSkillsJson(), true) ?: [];
$starterSkills = array_slice(array_values($skills), 0, 3);
?>

