<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/di.xsd">

    <!-- Config Repository -->
    <preference for="MagoAssistant\Mago\Api\Config\RepositoryInterface" type="MagoAssistant\Mago\Model\Config\Repository"/>

    <!-- Chat Service -->
    <preference for="MagoAssistant\Mago\Api\ChatServiceInterface" type="MagoAssistant\Mago\Service\Ai\ChatService"/>

    <!-- Conversation Repository -->
    <preference for="MagoAssistant\Mago\Api\ConversationRepositoryInterface" type="MagoAssistant\Mago\Model\Conversation\Repository"/>

    <!-- WebApi -->
    <preference for="MagoAssistant\Mago\Api\WebApi\ChatManagementInterface" type="MagoAssistant\Mago\Model\WebApi\ChatManagement"/>
    <preference for="MagoAssistant\Mago\Api\WebApi\IndexerManagementInterface" type="MagoAssistant\Mago\Model\WebApi\IndexerManagement"/>

    <!-- Module Info Repository -->
    <preference for="MagoAssistant\Mago\Api\ModuleInfo\RepositoryInterface" type="MagoAssistant\Mago\Model\ModuleInfo\Repository"/>
    <preference for="MagoAssistant\Mago\Api\ModuleInfo\InstalledPackagesInterface" type="MagoAssistant\Mago\Model\ModuleInfo\ComposerInstalledPackages"/>

    <!-- Tool Registry: inject all tools -->
    <type name="MagoAssistant\Mago\Service\Tool\ToolRegistry">
        <arguments>
            <argument name="permissionChecker" xsi:type="object">MagoAssistant\Mago\Service\Skills\PermissionChecker</argument>
            <argument name="tools" xsi:type="array">
                <item name="config_reader" xsi:type="object">MagoAssistant\Mago\Service\Skills\Configuration\ConfigReader</item>
                <item name="config_writer" xsi:type="object">MagoAssistant\Mago\Service\Skills\Configuration\ConfigWriter</item>
                <item name="cache_manager" xsi:type="object">MagoAssistant\Mago\Service\Skills\Configuration\CacheManager</item>
                <item name="indexer_manager" xsi:type="object">MagoAssistant\Mago\Service\Skills\Configuration\IndexerManager</item>
                <item name="sales_data" xsi:type="object">MagoAssistant\Mago\Service\Skills\Analytics\SalesData</item>
                <item name="product_data" xsi:type="object">MagoAssistant\Mago\Service\Skills\Analytics\ProductData</item>
                <item name="customer_data" xsi:type="object">MagoAssistant\Mago\Service\Skills\Analytics\CustomerData</item>
                <item name="content_generator" xsi:type="object">MagoAssistant\Mago\Service\Skills\Content\ContentGenerator</item>
                <item name="cms_data" xsi:type="object">MagoAssistant\Mago\Service\Skills\Content\CmsData</item>
                <item name="admin_navigator" xsi:type="object">MagoAssistant\Mago\Service\Skills\Navigation\AdminNavigator</item>
                <item name="coupon_manager" xsi:type="object">MagoAssistant\Mago\Service\Skills\Marketing\CouponManager</item>
                <item name="catalog_price_rules" xsi:type="object">MagoAssistant\Mago\Service\Skills\Marketing\CatalogPriceRules</item>
                <item name="url_rewrite_manager" xsi:type="object">MagoAssistant\Mago\Service\Skills\Seo\UrlRewriteManager</item>
                <item name="review_manager" xsi:type="object">MagoAssistant\Mago\Service\Skills\Catalog\ReviewManager</item>
                <item name="product_management" xsi:type="object">MagoAssistant\Mago\Service\Skills\Catalog\ProductManagement</item>
                <item name="order_manager" xsi:type="object">MagoAssistant\Mago\Service\Skills\Sales\OrderManager</item>
                <item name="cron_status" xsi:type="object">MagoAssistant\Mago\Service\Skills\System\CronStatus</item>
                <item name="product_debug" xsi:type="object">MagoAssistant\Mago\Service\Skills\Debug\ProductDebug</item>
                <item name="docs_search" xsi:type="object">MagoAssistant\Mago\Service\Skills\Docs\DocsSearch</item>
                <item name="module_version" xsi:type="object">MagoAssistant\Mago\Service\Skills\System\ModuleVersion</item>
                <item name="bulk_status" xsi:type="object">MagoAssistant\Mago\Service\Skills\System\BulkStatus</item>
            </argument>
        </arguments>
    </type>

    <!-- Slash commands: "/name subcommand" messages that run without the AI provider -->
    <type name="MagoAssistant\Mago\Service\Command\CommandRegistry">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="cache" xsi:type="object">MagoAssistant\Mago\Service\Command\CacheCommand</item>
                <item name="index" xsi:type="object">MagoAssistant\Mago\Service\Command\IndexCommand</item>
            </argument>
        </arguments>
    </type>

    <!-- Skill Actions: CouponManager -->
    <type name="MagoAssistant\Mago\Service\Skills\Marketing\CouponManager">
        <arguments>
            <argument name="actions" xsi:type="array">
                <item name="list_rules" xsi:type="object">MagoAssistant\Mago\Service\Skills\Marketing\CouponManager\ListRulesAction</item>
                <item name="get_rule" xsi:type="object">MagoAssistant\Mago\Service\Skills\Marketing\CouponManager\GetRuleAction</item>
                <item name="create_coupon" xsi:type="object">MagoAssistant\Mago\Service\Skills\Marketing\CouponManager\CreateCouponAction</item>
                <item name="create_rule" xsi:type="object">MagoAssistant\Mago\Service\Skills\Marketing\CouponManager\CreateRuleAction</item>
                <item name="deactivate_rule" xsi:type="object">MagoAssistant\Mago\Service\Skills\Marketing\CouponManager\DeactivateRuleAction</item>
            </argument>
        </arguments>
    </type>

    <!-- Skill Actions: DocsSearch -->
    <type name="MagoAssistant\Mago\Service\Skills\Docs\DocsSearch">
        <arguments>
            <argument name="actions" xsi:type="array">
                <item name="search" xsi:type="object">MagoAssistant\Mago\Service\Skills\Docs\DocsSearch\SearchAction</item>
                <item name="get_doc" xsi:type="object">MagoAssistant\Mago\Service\Skills\Docs\DocsSearch\GetDocAction</item>
            </argument>
        </arguments>
    </type>

    <!-- Skill Actions: CatalogPriceRules -->
    <type name="MagoAssistant\Mago\Service\Skills\Marketing\CatalogPriceRules">
        <arguments>
            <argument name="actions" xsi:type="array">
                <item name="list_rules" xsi:type="object">MagoAssistant\Mago\Service\Skills\Marketing\CatalogPriceRules\ListRulesAction</item>
                <item name="get_rule" xsi:type="object">MagoAssistant\Mago\Service\Skills\Marketing\CatalogPriceRules\GetRuleAction</item>
                <item name="create_rule" xsi:type="object">MagoAssistant\Mago\Service\Skills\Marketing\CatalogPriceRules\CreateRuleAction</item>
                <item name="deactivate_rule" xsi:type="object">MagoAssistant\Mago\Service\Skills\Marketing\CatalogPriceRules\DeactivateRuleAction</item>
                <item name="apply_rules" xsi:type="object">MagoAssistant\Mago\Service\Skills\Marketing\CatalogPriceRules\ApplyRulesAction</item>
            </argument>
        </arguments>
    </type>

    <!-- Skill Actions: UrlRewriteManager -->
    <type name="MagoAssistant\Mago\Service\Skills\Seo\UrlRewriteManager">
        <arguments>
            <argument name="actions" xsi:type="array">
                <item name="search" xsi:type="object">MagoAssistant\Mago\Service\Skills\Seo\UrlRewriteManager\SearchAction</item>
                <item name="create" xsi:type="object">MagoAssistant\Mago\Service\Skills\Seo\UrlRewriteManager\CreateAction</item>
                <item name="delete" xsi:type="object">MagoAssistant\Mago\Service\Skills\Seo\UrlRewriteManager\DeleteAction</item>
            </argument>
        </arguments>
    </type>

    <!-- Skill Actions: ReviewManager -->
    <type name="MagoAssistant\Mago\Service\Skills\Catalog\ReviewManager">
        <arguments>
            <argument name="actions" xsi:type="array">
                <item name="list_pending" xsi:type="object">MagoAssistant\Mago\Service\Skills\Catalog\ReviewManager\ListPendingAction</item>
                <item name="list_approved" xsi:type="object">MagoAssistant\Mago\Service\Skills\Catalog\ReviewManager\ListApprovedAction</item>
                <item name="approve" xsi:type="object">MagoAssistant\Mago\Service\Skills\Catalog\ReviewManager\ApproveAction</item>
                <item name="reject" xsi:type="object">MagoAssistant\Mago\Service\Skills\Catalog\ReviewManager\RejectAction</item>
                <item name="get_stats" xsi:type="object">MagoAssistant\Mago\Service\Skills\Catalog\ReviewManager\GetStatsAction</item>
            </argument>
        </arguments>
    </type>

    <!-- Skill Actions: OrderManager -->
    <type name="MagoAssistant\Mago\Service\Skills\Sales\OrderManager">
        <arguments>
            <argument name="actions" xsi:type="array">
                <item name="add_comment" xsi:type="object">MagoAssistant\Mago\Service\Skills\Sales\OrderManager\AddCommentAction</item>
                <item name="update_status" xsi:type="object">MagoAssistant\Mago\Service\Skills\Sales\OrderManager\UpdateStatusAction</item>
                <item name="create_shipment" xsi:type="object">MagoAssistant\Mago\Service\Skills\Sales\OrderManager\CreateShipmentAction</item>
                <item name="create_invoice" xsi:type="object">MagoAssistant\Mago\Service\Skills\Sales\OrderManager\CreateInvoiceAction</item>
                <item name="create_creditmemo" xsi:type="object">MagoAssistant\Mago\Service\Skills\Sales\OrderManager\CreateCreditmemoAction</item>
                <item name="cancel" xsi:type="object">MagoAssistant\Mago\Service\Skills\Sales\OrderManager\CancelAction</item>
            </argument>
        </arguments>
    </type>

    <!-- Skill Actions: CronStatus -->
    <type name="MagoAssistant\Mago\Service\Skills\System\CronStatus">
        <arguments>
            <argument name="actions" xsi:type="array">
                <item name="list_running" xsi:type="object">MagoAssistant\Mago\Service\Skills\System\CronStatus\ListRunningAction</item>
                <item name="list_schedule" xsi:type="object">MagoAssistant\Mago\Service\Skills\System\CronStatus\ListScheduleAction</item>
                <item name="list_failed" xsi:type="object">MagoAssistant\Mago\Service\Skills\System\CronStatus\ListFailedAction</item>
                <item name="health_check" xsi:type="object">MagoAssistant\Mago\Service\Skills\System\CronStatus\HealthCheckAction</item>
                <item name="schedule_job" xsi:type="object">MagoAssistant\Mago\Service\Skills\System\CronStatus\ScheduleJobAction</item>
            </argument>
        </arguments>
    </type>

    <!-- Skill Actions: ProductDebug -->
    <type name="MagoAssistant\Mago\Service\Skills\Debug\ProductDebug">
        <arguments>
            <argument name="actions" xsi:type="array">
                <item name="diagnose" xsi:type="object">MagoAssistant\Mago\Service\Skills\Debug\ProductDebug\DiagnoseAction</item>
            </argument>
        </arguments>
    </type>

    <!-- Skill Actions: ModuleVersion -->
    <type name="MagoAssistant\Mago\Service\Skills\System\ModuleVersion">
        <arguments>
            <argument name="actions" xsi:type="array">
                <item name="get_version" xsi:type="object">MagoAssistant\Mago\Service\Skills\System\ModuleVersion\GetVersionAction</item>
            </argument>
        </arguments>
    </type>

    <!-- Docs indexing CLI command -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="mago_docs_index" xsi:type="object">MagoAssistant\Mago\Console\Command\IndexDocs</item>
            </argument>
        </arguments>
    </type>

    <!-- Skill Actions: SalesData -->
    <type name="MagoAssistant\Mago\Service\Skills\Analytics\SalesData">
        <arguments>
            <argument name="actions" xsi:type="array">
                <item name="revenue_summary" xsi:type="object">MagoAssistant\Mago\Service\Skills\Analytics\SalesData\RevenueAction</item>
                <item name="top_products" xsi:type="object">MagoAssistant\Mago\Service\Skills\Analytics\SalesData\TopProductsAction</item>
                <item name="top_refunded" xsi:type="object">MagoAssistant\Mago\Service\Skills\Analytics\SalesData\TopRefundedAction</item>
                <item name="recent_orders" xsi:type="object">MagoAssistant\Mago\Service\Skills\Analytics\SalesData\RecentOrdersAction</item>
                <item name="order_count" xsi:type="object">MagoAssistant\Mago\Service\Skills\Analytics\SalesData\OrderCountAction</item>
                <item name="lookup_order" xsi:type="object">MagoAssistant\Mago\Service\Skills\Analytics\SalesData\LookupOrderAction</item>
                <item name="search_orders" xsi:type="object">MagoAssistant\Mago\Service\Skills\Analytics\SalesData\SearchOrdersAction</item>
                <item name="customer_orders" xsi:type="object">MagoAssistant\Mago\Service\Skills\Analytics\SalesData\CustomerOrdersAction</item>
            </argument>
        </arguments>
    </type>

    <!-- Skill Actions: CustomerData -->
    <type name="MagoAssistant\Mago\Service\Skills\Analytics\CustomerData">
        <arguments>
            <argument name="actions" xsi:type="array">
                <item name="count" xsi:type="object">MagoAssistant\Mago\Service\Skills\Analytics\CustomerData\CountAction</item>
                <item name="recent_signups" xsi:type="object">MagoAssistant\Mago\Service\Skills\Analytics\CustomerData\RecentSignupsAction</item>
                <item name="top_spenders" xsi:type="object">MagoAssistant\Mago\Service\Skills\Analytics\CustomerData\TopSpendersAction</item>
                <item name="lookup_customer" xsi:type="object">MagoAssistant\Mago\Service\Skills\Analytics\CustomerData\LookupCustomerAction</item>
            </argument>
        </arguments>
    </type>

    <!-- Skill Actions: ProductData -->
    <type name="MagoAssistant\Mago\Service\Skills\Analytics\ProductData">
        <arguments>
            <argument name="actions" xsi:type="array">
                <item name="search" xsi:type="object">MagoAssistant\Mago\Service\Skills\Analytics\ProductData\SearchAction</item>
                <item name="get_by_sku" xsi:type="object">MagoAssistant\Mago\Service\Skills\Analytics\ProductData\GetBySkuAction</item>
                <item name="count" xsi:type="object">MagoAssistant\Mago\Service\Skills\Analytics\ProductData\CountAction</item>
                <item name="low_stock" xsi:type="object">MagoAssistant\Mago\Service\Skills\Analytics\ProductData\LowStockAction</item>
            </argument>
        </arguments>
    </type>

    <!-- Skill Actions: CmsData -->
    <type name="MagoAssistant\Mago\Service\Skills\Content\CmsData">
        <arguments>
            <argument name="actions" xsi:type="array">
                <item name="list_pages" xsi:type="object">MagoAssistant\Mago\Service\Skills\Content\CmsData\ListPagesAction</item>
                <item name="get_page" xsi:type="object">MagoAssistant\Mago\Service\Skills\Content\CmsData\GetPageAction</item>
                <item name="update_page" xsi:type="object">MagoAssistant\Mago\Service\Skills\Content\CmsData\UpdatePageAction</item>
                <item name="list_blocks" xsi:type="object">MagoAssistant\Mago\Service\Skills\Content\CmsData\ListBlocksAction</item>
                <item name="get_block" xsi:type="object">MagoAssistant\Mago\Service\Skills\Content\CmsData\GetBlockAction</item>
                <item name="update_block" xsi:type="object">MagoAssistant\Mago\Service\Skills\Content\CmsData\UpdateBlockAction</item>
                <item name="create_page" xsi:type="object">MagoAssistant\Mago\Service\Skills\Content\CmsData\CreatePageAction</item>
                <item name="create_block" xsi:type="object">MagoAssistant\Mago\Service\Skills\Content\CmsData\CreateBlockAction</item>
            </argument>
        </arguments>
    </type>

    <!-- Skills Grid DataProvider -->
    <type name="MagoAssistant\Mago\Ui\DataProvider\SkillsDataProvider">
        <arguments>
            <argument name="name" xsi:type="string">mago_skills_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">name</argument>
            <argument name="requestFieldName" xsi:type="string">name</argument>
        </arguments>
    </type>

    <!-- Conversations Grid DataProvider -->
    <type name="MagoAssistant\Mago\Ui\DataProvider\ConversationsDataProvider">
        <arguments>
            <argument name="name" xsi:type="string">mago_conversations_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
        </arguments>
    </type>

    <!-- Debug Logger -->
    <virtualType name="MagoAssistantMagoDebugHandler" type="MagoAssistant\Mago\Logger\Handler\Debug"/>
    <virtualType name="MagoAssistantMagoDebugLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">MagoAssistantMagoDebug</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">MagoAssistantMagoDebugHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="MagoAssistant\Mago\Logger\DebugLogger">
        <arguments>
            <argument name="logger" xsi:type="object">MagoAssistantMagoDebugLogger</argument>
        </arguments>
    </type>

    <!-- Error Logger -->
    <virtualType name="MagoAssistantMagoErrorHandler" type="MagoAssistant\Mago\Logger\Handler\Error"/>
    <virtualType name="MagoAssistantMagoErrorLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">MagoAssistantMagoError</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">MagoAssistantMagoErrorHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="MagoAssistant\Mago\Logger\ErrorLogger">
        <arguments>
            <argument name="logger" xsi:type="object">MagoAssistantMagoErrorLogger</argument>
        </arguments>
    </type>

    <!-- Skill Actions: ProductManagement -->
    <type name="MagoAssistant\Mago\Service\Skills\Catalog\ProductManagement">
        <arguments>
            <argument name="actions" xsi:type="array">
                <item name="list_attribute_sets" xsi:type="object">MagoAssistant\Mago\Service\Skills\Catalog\ProductManagement\ListAttributeSetsAction</item>
                <item name="get_attribute_options" xsi:type="object">MagoAssistant\Mago\Service\Skills\Catalog\ProductManagement\GetAttributeOptionsAction</item>
                <item name="create_product" xsi:type="object">MagoAssistant\Mago\Service\Skills\Catalog\ProductManagement\CreateProductAction</item>
                <item name="add_configurable_variants" xsi:type="object">MagoAssistant\Mago\Service\Skills\Catalog\ProductManagement\AddConfigurableVariantsAction</item>
            </argument>
        </arguments>
    </type>
</config>
