<?xml version="1.0"?>
<include xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_include.xsd">
    <group id="api" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
        <label>API Settings</label>
        <attribute type="expanded">1</attribute>
        <field id="ai_service" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>AI Service</label>
            <source_model>MageOS\AiBase\Model\Config\Source\ConfiguredServiceWithAutomatic</source_model>
            <comment model="MagoAssistant\Mago\Model\Config\Comment\AiServiceLink"/>
        </field>
        <field id="max_tokens" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
            <label>Max Tokens</label>
            <comment>Maximum tokens per response (default: 4096)</comment>
            <validate>validate-digits</validate>
        </field>
        <field id="streaming" translate="label comment" type="select" sortOrder="60" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
            <label>Enable Streaming</label>
            <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
            <comment>Stream AI responses in real-time via SSE</comment>
        </field>
        <field id="internal_url" translate="label comment" type="text" sortOrder="90" showInDefault="1" showInWebsite="0" showInStore="0">
            <label>Internal API URL</label>
            <comment><![CDATA[Leave empty to use store base URL. For Docker setups, enter the nginx container URL (e.g. https://nginx:443). Used for internal REST API calls. These calls authenticate with an admin bearer token: over plain http to a non-loopback host that token travels unencrypted, so use https (or a loopback address) anywhere the URL crosses a network.]]></comment>
            <frontend_model>MagoAssistant\Mago\Block\Adminhtml\System\Config\DetectUrl</frontend_model>
        </field>
        <field id="internal_ssl_verify" translate="label comment" type="select" sortOrder="95" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
            <label>Verify TLS Certificate</label>
            <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
            <comment><![CDATA[Verify the TLS certificate on internal REST API calls. Keep enabled in production. Disable for local or Docker setups where the certificate does not match the internal URL host.]]></comment>
        </field>
    </group>
</include>
