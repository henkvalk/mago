<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="mago_docs">
        <job name="mago_docs_sync" instance="MagoAssistant\Mago\Cron\SyncDocs" method="execute">
            <config_path>mago/docs/cron_expr</config_path>
        </job>
    </group>
    <group id="mago">
        <job name="mago_usage_clean_payloads" instance="MagoAssistant\Mago\Cron\CleanUsageLog" method="execute">
            <schedule>0 3 * * *</schedule>
        </job>
        <job name="mago_prune_conversations" instance="MagoAssistant\Mago\Cron\PruneConversations" method="execute">
            <schedule>0 4 * * *</schedule>
        </job>
    </group>
</config>
